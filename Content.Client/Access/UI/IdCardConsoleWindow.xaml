<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      MinSize="650 690"
                      MaxHeight="900"
                      MaxWidth="900">
    <BoxContainer Orientation="Vertical" Margin="8 2">
        <PanelContainer StyleClasses="SurfacePrimary">
            <BoxContainer Orientation="Vertical" Margin="8">
                <BoxContainer HorizontalExpand="True">
                    <Label Align="Center" Text="{Loc 'id-card-console-window-modal-idmodification'}" Margin="8 0 0 0"
                           StyleClasses="SectionHeader" />
                    <BoxContainer HorizontalExpand="True" />
                    <Button Name="CrewManifestButton" Access="Public" Text="{Loc 'crew-manifest-button-label'}"
                            SizeFlagsStretchRatio="2" />
                </BoxContainer>
                <PanelContainer StyleClasses="SeperatorAccented" SetHeight="2" HorizontalExpand="True" Margin="8 4" />
                <!-- Privileged and target IDs, crew manifest button. -->
                <BoxContainer Orientation="Horizontal">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <BoxContainer HorizontalExpand="True" SizeFlagsStretchRatio="0.25" />

                        <Label Text="{Loc 'id-card-console-window-privileged-id'}" Margin="8 0" />
                        <Button Name="PrivilegedIdButton" Access="Public" />
                        <Label Name="PrivilegedIdLabel" />
                        <BoxContainer HorizontalExpand="True" SizeFlagsStretchRatio="0.25" />

                        <Label Text="{Loc 'id-card-console-window-target-id'}" Margin="8 0" />
                        <Button Name="TargetIdButton" Access="Public" />
                        <Label Name="TargetIdLabel" />

                        <BoxContainer HorizontalExpand="True" SizeFlagsStretchRatio="0.25" />
                    </BoxContainer>

                </BoxContainer>

                <Control MinSize="0 8" />
                <!-- Full name and job title editing. -->
                <GridContainer Columns="3" HSeparationOverride="4">
                    <Label Name="FullNameLabel" Text="{Loc 'id-card-console-window-full-name-label'}" />
                    <LineEdit Name="FullNameLineEdit" HorizontalExpand="True" />
                    <Button Name="FullNameSaveButton" Text="{Loc 'id-card-console-window-save-button'}" Disabled="True" />

                    <Label Name="JobTitleLabel" Text="{Loc 'id-card-console-window-job-title-label'}" />
                    <LineEdit Name="JobTitleLineEdit" HorizontalExpand="True" />
                    <Button Name="JobTitleSaveButton" Text="{Loc 'id-card-console-window-save-button'}" Disabled="True" />
                </GridContainer>
            </BoxContainer>
        </PanelContainer>
        <Control MinSize="0 8" />
        <!-- Job preset selection, grant/revoke all access buttons. -->
        <BoxContainer Margin="0 8 0 4">
            <BoxContainer>
                <Label Text="{Loc 'id-card-console-window-job-selection-label'}" />
                <controls:TguiOptionButton Name="JobPresetOptionButton" />
            </BoxContainer>
            <Control HorizontalExpand="True" />

            <BoxContainer>
                <Button Name="SelectAllButton" Text="{Loc 'id-card-console-window-select-all-button'}" />
                <Button Name="DeselectAllButton" Text="{Loc 'id-card-console-window-deselect-all-button'}" />
            </BoxContainer>

        </BoxContainer>
        <!-- Individual access buttons -->
        <PanelContainer StyleClasses="SurfacePrimary" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
                <ScrollContainer HorizontalExpand="True" VerticalExpand="True" SizeFlagsStretchRatio="0.4">
                    <BoxContainer Name="DepartmentSelectionHolder" Orientation="Vertical" HorizontalExpand="True"
                                  VerticalExpand="True" SizeFlagsStretchRatio="0.5" Margin="16 8 4 8" SeparationOverride="4">

                    </BoxContainer>
                </ScrollContainer>
                <ScrollContainer HorizontalExpand="True" VerticalExpand="True" SizeFlagsStretchRatio="1">
                    <BoxContainer Name="DepartmentMenuHolder" Orientation="Vertical" HorizontalExpand="True"
                                  VerticalExpand="True" SizeFlagsStretchRatio="1">

                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
